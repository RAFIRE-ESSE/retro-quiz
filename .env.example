# =====================================================================
# Microsoft SQL Server / Azure SQL Database Configuration
# =====================================================================

# Server hostname or IP address (e.g., 'localhost' or 'myserver.database.windows.net')
MSSQL_SERVER=localhost

# Database Port (Default is 1433)
MSSQL_PORT=1433

# Database Name
MSSQL_DATABASE=QuizArcadeDB

# Database User
MSSQL_USER=sa

# Database Password
MSSQL_PASSWORD=YourStrong@Passw0rd!

# SSL / Encryption (Set to true for Azure SQL Database)
MSSQL_ENCRYPT=true

# Trust Server Certificate (Set to true for local Docker / self-signed certs)
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Connection Timeout in Milliseconds
MSSQL_TIMEOUT=15000

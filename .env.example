# Neon Serverless Postgres Database Configuration (Vercel Native)
DATABASE_URL=postgresql://user:password@ep-example-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_URL=postgresql://user:password@ep-example-pooler.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require

# Microsoft SQL Server Configuration (Optional)
MSSQL_SERVER=your-server-name.database.windows.net
MSSQL_PORT=1433
MSSQL_DATABASE=QuizArcadeDB
MSSQL_USER=your-db-username
MSSQL_PASSWORD=your-secure-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
MSSQL_TIMEOUT=15000
